# Salin ke .env.local (di-gitignore). Jangan pernah meng-commit nilai asli.
# Daftar lengkap dan alasannya ada di HANDOFF.md bagian "Environment".

# Connection string Supabase, WAJIB transaction pooler (port 6543), bukan 5432.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@[host].pooler.supabase.com:6543/postgres"

# Penanda tangan token sesi staf. Wajib; buat acak: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# Alamat publik aplikasi ini (dipakai untuk link pendataan jamaah).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dokumen jamaah (bucket private) lewat Supabase Storage. Service role HANYA dipakai di server.
# Bucket dibuat dengan: node --env-file=.env.local scratch/buat-bucket-dokumen-jamaah.mjs
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_DOCS_BUCKET="dokumen-jamaah"

# Origin aplikasi UmrahMe yang boleh memanggil /api/pendataan (pisahkan dengan koma, tanpa spasi).
# Harus sama dengan domain UmrahMe; kalau kosong, UmrahMe kena CORS dan tombol "Kembali" tidak muncul.
UMRAHME_ORIGINS="https://umrahme-elmassa.vercel.app,http://localhost:5173"

# Biarkan kosong. Isi "true" hanya sesaat ketika memang mau menghapus semua paket, booking, dan pelanggan.
# ALLOW_DATA_RESET="true"

# Password admin pertama saat staff_users masih kosong.
# INITIAL_ADMIN_PASSWORD=""
